# URL do agent-service (FastAPI). Copie para .env.local e ajuste se necessário.
NEXT_PUBLIC_AGENT_API=http://localhost:8000

# CSP (Content-Security-Policy): o painel publica a política com nonce por
# requisição. Por padrão em Report-Only (não bloqueia, só reporta no console do
# navegador). Após validar que o painel não gera violação real, ligue o
# enforcement:
# CSP_ENFORCE=true
