# Config da stack Docker (copie para .env.docker e preencha). NÃO commitar.

# --- Postgres local (Evolution + N8N + RAG dev) ---
LOCAL_PG_USER=paratec
LOCAL_PG_PASSWORD=troque-esta-senha
LOCAL_PG_DB=paratec_stack

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=gere-uma-chave-forte

# --- N8N ---
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Catálogo (Postgres de produção — pg.atentbot.com) ---
PGHOST=pg.atentbot.com
PGPORT=5432
PGDATABASE=paratec
PGUSER=postgres
PGPASSWORD=

# --- LLM (Google Gemini) ---
GOOGLE_API_KEY=
# gemini-flash-latest (rápido/barato, sempre o flash atual) | gemini-pro-latest (mais capaz)
LLM_MODEL=gemini-flash-latest

# --- Tela administrativa (Next.js) ---
# Origens liberadas no CORS do agent-service (onde o admin roda).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# URL do agent-service acessível PELO NAVEGADOR do admin (embutida no build).
# Local: http://localhost:8000. Produção: https://api.seu-dominio.
ADMIN_AGENT_API=http://localhost:8000

# --- Envio de saída (Evolution API), usado pelo painel p/ responder humano ---
# URL interna do serviço evolution-api na rede do compose. Vazio = desabilitado.
# A EVOLUTION_API_KEY deve ser a chave GLOBAL da Evolution (AUTHENTICATION_API_KEY):
# o agent-service a usa como proxy para o painel gerenciar instâncias/QR Code.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_INSTANCE=paratec
# Instância da PLATAFORMA (número do AtentBot) que envia o código de verificação
# do WhatsApp no cadastro. Nunca use o número de um cliente.
WHATSAPP_VERIFICACAO_INSTANCIA=
# EVOLUTION_API_KEY reaproveita a mesma chave definida acima.
# Webhook que a Evolution deve chamar ao conectar um NÚMERO NOVO pelo painel
# (normalmente o webhook do N8N que chama o agente). Vazio = não configura
# webhook automaticamente. Ex.: http://n8n:5678/webhook/paratec-whatsapp
EVOLUTION_WEBHOOK_URL=

# --- SaaS: assinatura (Stripe) e sessão de login ---
# Vazio = billing desabilitado (assinatura_ativa libera tudo — útil em dev).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (recorrentes) criados no dashboard do Stripe, um por plano.
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_ESCALA=
# URLs de retorno do Checkout (no site/painel).
BILLING_SUCCESS_URL=https://app.atentbot.com/checkout/sucesso
BILLING_CANCEL_URL=https://app.atentbot.com/checkout/cancelado
# Carência (dias) para assinatura em past_due antes de bloquear o acesso.
PAST_DUE_GRACE_DAYS=3
# Sessão de login do painel (cookie próprio; substitui o Authentik).
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
# Tenant de fallback p/ instâncias ainda não mapeadas (dados de produção atuais).
DEFAULT_TENANT_SLUG=paratec
# URL pública do painel (link nos alertas aos vendedores).
PANEL_URL=https://app.atentbot.com

# --- Cobrança AUTOMÁTICA dos extras (Stripe Billing Meters) ---
# Vazio = desligado (só mede e mostra). Para ligar: crie 2 meters + 2 preços
# metered no Stripe (ver docs/DEPLOY_SAAS.md) e preencha abaixo.
STRIPE_METER_INDEXACAO=            # event_name do meter de indexação
STRIPE_METER_CONVERSA=            # event_name do meter de conversa
STRIPE_PRICE_METER_INDEXACAO=     # price id metered (indexação)
STRIPE_PRICE_METER_CONVERSA=      # price id metered (conversa)

# --- E-mail (SMTP) para notificações de chamados de suporte ---
# NÃO commitar SMTP_PASS — preencha só no .env.docker (gitignored).
SMTP_HOST=mail.dewconsultoria.com.br
SMTP_PORT=587
SMTP_USER=notreply@dewconsultoria.com.br
SMTP_PASS=
SMTP_SSL=true
SMTP_FROM_NAME=AtentBot
SMTP_FROM_EMAIL=notreply@dewconsultoria.com.br
SMTP_REPLY_TO=contato@dewconsultoria.com.br
SUPPORT_EMAIL=contato@dewconsultoria.com.br
