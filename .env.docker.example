# Config da stack Docker (copie para .env.docker e preencha). NÃO commitar.

# --- Postgres local (Evolution + N8N + RAG dev) ---
LOCAL_PG_USER=paratec
LOCAL_PG_PASSWORD=troque-esta-senha
LOCAL_PG_DB=paratec_stack

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=gere-uma-chave-forte

# --- N8N ---
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Catálogo (Postgres de produção — pg.atentbot.com) ---
PGHOST=pg.atentbot.com
PGPORT=5432
PGDATABASE=paratec
PGUSER=postgres
PGPASSWORD=

# --- LLM (Google Gemini) ---
GOOGLE_API_KEY=
# gemini-flash-latest (rápido/barato, sempre o flash atual) | gemini-pro-latest (mais capaz)
LLM_MODEL=gemini-flash-latest

# --- Tela administrativa (Next.js) ---
# Origens liberadas no CORS do agent-service (onde o admin roda).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# URL do agent-service acessível PELO NAVEGADOR do admin (embutida no build).
# Local: http://localhost:8000. Produção: https://api.seu-dominio.
ADMIN_AGENT_API=http://localhost:8000

# --- Envio de saída (Evolution API), usado pelo painel p/ responder humano ---
# URL interna do serviço evolution-api na rede do compose. Vazio = desabilitado.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_INSTANCE=paratec
# EVOLUTION_API_KEY reaproveita a mesma chave definida acima.
