# Config da stack Docker (copie para .env.docker e preencha). NÃO commitar.

# --- Postgres local (Evolution + N8N + RAG dev) ---
LOCAL_PG_USER=paratec
LOCAL_PG_PASSWORD=troque-esta-senha
LOCAL_PG_DB=paratec_stack

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=gere-uma-chave-forte

# --- N8N ---
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Catálogo (Postgres de produção — pg.atentbot.com) ---
PGHOST=pg.atentbot.com
PGPORT=5432
PGDATABASE=paratec
PGUSER=postgres
PGPASSWORD=

# --- LLM (Google Gemini) ---
GOOGLE_API_KEY=
# gemini-2.5-flash (rápido/barato p/ alto volume) | gemini-2.5-pro (mais capaz)
LLM_MODEL=gemini-2.5-flash
